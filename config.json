{
  "config_version": "2.0",
  "description": "Single source of control and organization parameters. The functional and technical specifications reference this file; neither restates a literal value.",

  "organization": {
    "pages_total": 20,
    "chapters": 5,
    "pages_per_chapter": 4,
    "acts": {
      "setup": 4,
      "development": 12,
      "resolution": 4
    },
    "anchor_pages": [5, 10, 16]
  },

  "page": {
    "target_words": 350,
    "length_tolerance": 0.20
  },

  "story": {
    "tone": "classic adventure",
    "audience": "general reader",
    "language": "en"
  },

  "context": {
    "max_sheets_per_page": 3,
    "verbatim_summary_window": 8,
    "include_bridge_paragraph": true
  },

  "bible": {
    "world_rules_min": 4,
    "world_rules_max": 8,
    "max_characters": 6,
    "max_settings": 5
  },

  "control": {
    "max_retries_per_page": 2,
    "max_flagged_ratio": 0.10,
    "consistency_gate_max_attempts": 3,
    "abort_on_invalid_config": true,
    "resume_enabled": true
  },

  "model": {
    "id": null,
    "temperature": 0.8,
    "max_output_tokens": null
  },

  "paths": {
    "premise": "bible/premise.md",
    "world_rules": "bible/rules.md",
    "characters_dir": "bible/characters/",
    "settings_dir": "bible/settings/",
    "beats": "bible/beats.json",
    "state_log": "state/deltas.jsonl",
    "chapter_digests_dir": "state/chapters/",
    "pages_dir": "pages/",
    "runs_dir": "runs/",
    "manuscript": "story.md",
    "report": "report.md"
  }
}
