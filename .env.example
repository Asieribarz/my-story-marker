# Raíz de los directorios de proyecto (spec-backend-1.md §5.3). Por defecto, proyectos/ en la raíz
# del repositorio, que se commitea: sus datos de persona son ficticios (AGENTS.md).
MSM_PROYECTOS=

# Langfuse (E-1): el backend envía trazas, scores y versiones de prompt, solo metadatos.
# Sin las dos claves no se envía nada. MSM_LANGFUSE=0 lo apaga aunque estén.
LANGFUSE_PUBLIC_KEY=pk-lf-TU_CLAVE_AQUI
LANGFUSE_SECRET_KEY=sk-lf-TU_CLAVE_AQUI
LANGFUSE_BASE_URL=https://cloud.langfuse.com
MSM_LANGFUSE=

# El MCP de Langfuse de .mcp.json (sesión de desarrollo: prompts y consultas) lee
# LANGFUSE_MCP_AUTH del entorno de Claude Code, no de este fichero: es base64 de
# "clave_publica:clave_secreta".
